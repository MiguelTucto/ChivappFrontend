# ========================================================
# CHIVAPP FRONTEND - VARIABLES DE ENTORNO PARA PRODUCCIÓN
# Dominio: chiv.app
# ========================================================

# Base pública de la API en el navegador (mantiene same-origin con /api/v1)
NEXT_PUBLIC_API_URL=/api/v1

# Dominio público oficial del sitio
NEXT_PUBLIC_SITE_URL=https://chiv.app

# Destino interno del proxy de Next.js hacia el Backend FastAPI
# En Cloud Run puede ser el servicio de Cloud Run Backend o https://api.chiv.app
API_PROXY_TARGET=https://api.chiv.app

# ========================================================
# MERCADO PAGO - PUBLIC KEY DE PRODUCCIÓN
# ========================================================
NEXT_PUBLIC_MERCADO_PAGO_PUBLIC_KEY=APP_USR-TU_PUBLIC_KEY_PRODUCCION
